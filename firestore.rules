rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION FUNCTIONS
    // ==========================================
    function isLoggedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isLoggedIn() && request.auth.uid == userId; 
    }
    function isAdmin() { 
      return isLoggedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; 
    }
    function isTournamentOpen(tournamentId) {
      let t = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      return t.status != 'closed' && request.time <= t.deadline;
    }

    // ==========================================
    // 2. GLOBAL ADMIN OVERRIDES
    // ==========================================
    match /{path=**}/transactions/{docId}           { allow read, write: if isAdmin(); }
    match /{path=**}/notifications/{docId}          { allow read, write: if isAdmin(); }

    // ==========================================
    // 3. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isOwner(userId) && 
                    !request.resource.data.keys().hasAny(['isAdmin', 'isLeader'])
                    && (!request.resource.data.keys().hasAny(['nickname']) || (request.resource.data.nickname is string && request.resource.data.nickname.size() >= 3 && request.resource.data.nickname.size() <= 30))
                    && (!request.resource.data.keys().hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.matches('^[+]?[0-9]{10,15}$')))
                    && (!request.resource.data.keys().hasAny(['pilotRigUid']) || (request.resource.data.pilotRigUid is string && request.resource.data.pilotRigUid.size() <= 50));
      allow update: if isAdmin() || (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isLeader', 'wallet', 'bonusCredits']))
        || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId', 'teamName', 'teamCode', 'role', 'isLeader']) 
            && request.resource.data.teamId == null);
    }
    match /users/{userId}/notifications/{notifId}           { allow read, write: if isOwner(userId) || isAdmin(); }
    
    // Payment-related 1: pendingPayment
    match /users/{userId}/pendingPayment/{tournamentId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.paymentStatus == 'pending' && isTournamentOpen(tournamentId) && (request.resource.data.get('utr', '').matches('^[0-9]{12}$') || !request.resource.data.keys().hasAny(['utr'])));
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.paymentStatus == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['utr']) && request.resource.data.utr.matches('^[0-9]{12}$')); 
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Payment-related 2: users/{uid}/upcomingRegistrations
    match /users/{userId}/upcomingRegistrations/{docId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      // The tournament ID isn't directly in this path, but if they are writing to their own upcomingRegistrations, it might just be a mirror. Let's assume server mirror, or if client does it, they must be admin.
      // Wait, "Users may create the 6 payment-related documents only with paymentStatus pending".
      // If we don't have tournamentId, we can't check isTournamentOpen. The requirements just said block joins to closed tournament. 
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.paymentStatus == 'pending');
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.paymentStatus == 'pending' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']));
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /users/{userId}/confirmedRegistrations/{docId}    { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/performanceHistory/{docId}        { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/private/{docId}                   { allow read, write: if isOwner(userId) || isAdmin(); }
    
    match /users/{userId}/wallet/{walletId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /users/{userId}/transactions/{transId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 4. TOURNAMENTS COLLECTION
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); 

      // Payment-related 3: tournaments/{t}/participants
      match /participants/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.paymentStatus == 'pending'
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) && request.resource.data.paymentStatus == 'pending' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']));
        allow delete: if isAdmin() || isOwner(docId);
      }
      
      // Payment-related 4: tournaments/{t}/verifications
      match /verifications/{docId} { 
        allow read: if isOwner(docId) || isAdmin(); 
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.paymentStatus == 'pending' 
                      && request.resource.data.get('status', '') != 'approved'
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) 
                      && request.resource.data.paymentStatus == 'pending'
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'paymentStatus']));
        allow delete: if isOwner(docId) || isAdmin(); 
      }
      
      match /teamSessions/{teamId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin() || isOwner(teamId) || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members); 
      }
      
      match /limitedNotifyList/{docId} { 
        allow read, write: if isOwner(docId) || isAdmin(); 
      }
      
      // Payment-related 5: tournaments/{t}/slots
      match /slots/{slotId} {
        allow read: if true; 
        allow create: if isAdmin() || (isLoggedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.paymentStatus == 'pending' && isTournamentOpen(tournamentId));
        allow update, delete: if isAdmin(); 
      }

      match /leaderboard/{rankId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      // Payment-related 6: tournaments/{t}/upcomingRegistrations
      match /upcomingRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.paymentStatus == 'pending' 
                      && request.resource.data.get('status', '') != 'approved'
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) && 
          request.resource.data.paymentStatus == 'pending' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'paymentStatus'])
        );
        allow delete: if isOwner(docId) || isAdmin();
      }

      match /lockedRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==========================================
    // 5. TEAMS COLLECTION
    // ==========================================
    match /teams/{teamId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() 
                    && request.resource.data.maxMembers is number 
                    && request.resource.data.maxMembers > 0
                    && request.resource.data.leaderId == request.auth.uid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == null // block users in two teams
                    && request.resource.data.teamName is string
                    && request.resource.data.teamName.size() >= 3
                    && request.resource.data.teamName.size() <= 50;
      
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.leaderId == request.auth.uid && !resource.data.hasActiveRegistration);
      
      allow update: if isAdmin() 
        || (isLoggedIn() && resource.data.leaderId == request.auth.uid)
        || (isLoggedIn() && request.auth.uid in resource.data.members)
        || (isLoggedIn() 
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() <= resource.data.maxMembers
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId == null);
      
      match /wallet/{walletId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin(); 
      }
      
      match /transactions/{txId} {
        allow read: if isAdmin() || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow write: if isAdmin();
      }
      
      match /tournamentHistory/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // 6. SYSTEM & ADMIN DATA
    // ==========================================
    match /refundRequests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminNotifications/{notifId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /reports/{reportId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /calendarEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /systemEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // ==========================================
    // 7. PUSH NOTIFICATION QUEUE
    // ==========================================
    match /pushQueue/{userId}/tasks/{taskId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // ==========================================
    // 8. PAYMENT & WALLET SYSTEM
    // ==========================================
    match /submitted_utrs/{utr} {
      // Backend Admin SDK only 🔒 prevents clients from spoofing UTR duplicates
      allow read, write: if false;
    }
    
    match /team_verification_history/{teamId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow create: if isLoggedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount > 0;
      allow read: if isAdmin() || (isLoggedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
  }
}
