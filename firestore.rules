rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION FUNCTIONS
    // ==========================================
    function isLoggedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isLoggedIn() && request.auth.uid == userId; 
    }
    function isAdmin() { 
      return isLoggedIn() && (
        (request.auth.token.get('email', '') in ['ariyanabedin69@gmail.com', 'test@gmail.com']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == 'true' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        ))
      ); 
    }
    function isTournamentOpen(tournamentId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId))
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('status', '') != 'closed'
        && (!('deadline' in get(/databases/$(database)/documents/tournaments/$(tournamentId)).data) || request.time <= get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.deadline);
    }

    // ==========================================
    // 2. GLOBAL ADMIN OVERRIDES & COLLECTION GROUPS
    // ==========================================
    match /{path=**}/verifications/{docId}         { allow read, write: if isAdmin(); }
    match /{path=**}/upcomingRegistrations/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/participants/{docId}          { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{docId}          { allow read, write: if isAdmin(); }
    match /{path=**}/notifications/{docId}         { allow read, write: if isAdmin(); }
    match /{path=**}/slots/{docId}                 { allow read, write: if isAdmin(); }
    match /{path=**}/wallet/{docId}                { allow read, write: if isAdmin(); }
    match /{path=**}/teamSessions/{docId}          { allow read, write: if isAdmin(); }

    // ==========================================
    // 3. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isLoggedIn();
      // Allow user to create their initial profile; strictly forbid granting self isAdmin: true
      allow create: if isAdmin() || (isOwner(userId) 
        && request.resource.data.get('isAdmin', false) == false
        && (!request.resource.data.keys().hasAny(['phone']) || request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.matches('^[+]?[0-9]{10,15}$'))));
      // Allow user to update their profile; strictly block altering isAdmin, wallet balance, or bonusCredits
      allow update: if isAdmin() || (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'wallet', 'bonusCredits']))
        || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId', 'teamName', 'teamCode', 'role', 'isLeader']) 
            && request.resource.data.get('teamId', null) == null);
      allow delete: if isAdmin();
    }
    
    // Notifications subcollection:
    // User can read & manage their own; teammates, leaders and admins can send notifications to any user
    match /users/{userId}/notifications/{notifId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isLoggedIn(); 
      allow update, delete: if isOwner(userId) || isAdmin();
    }
    
    // Payment-related 1: pendingPayment
    match /users/{userId}/pendingPayment/{tournamentId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] && isTournamentOpen(tournamentId) && (request.resource.data.get('utr', '').matches('^[0-9]{12}$') || !request.resource.data.keys().hasAny(['utr'])));
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['utr']) && request.resource.data.get('utr', '').matches('^[0-9]{12}$')); 
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // Payment-related 2: users/{uid}/upcomingRegistrations
    match /users/{userId}/upcomingRegistrations/{docId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification']);
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']));
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    match /users/{userId}/confirmedRegistrations/{docId}    { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/performanceHistory/{docId}        { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/private/{docId}                   { allow read, write: if isOwner(userId) || isAdmin(); }
    
    // Wallet: Users initialize their own wallet with balance 0 upon signup; only admin can credit/debit
    match /users/{userId}/wallet/{walletId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && request.resource.data.get('balance', 0) == 0) || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId}/transactions/{transId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 4. TOURNAMENTS COLLECTION
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); 

      // Payment-related 3: tournaments/{t}/participants
      match /participants/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.get('userId', '') == request.auth.uid)) 
                      && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification']
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']));
        allow delete: if isAdmin() || isOwner(docId);
      }
      
      // Payment-related 4: tournaments/{t}/verifications
      match /verifications/{docId} { 
        allow read: if isOwner(docId) || isAdmin(); 
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.get('userId', '') == request.auth.uid)) 
                      && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] 
                      && request.resource.data.get('status', '') != 'approved'
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) 
                      && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification']
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'paymentStatus']));
        allow delete: if isOwner(docId) || isAdmin(); 
      }
      
      match /teamSessions/{teamId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin() || isOwner(teamId) || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members); 
      }
      
      match /limitedNotifyList/{docId} { 
        allow read, write: if isOwner(docId) || isAdmin(); 
      }
      
      // Payment-related 5: tournaments/{t}/slots
      match /slots/{slotId} {
        allow read: if true; 
        allow create: if isAdmin() || (isLoggedIn() && request.resource.data.get('userId', '') == request.auth.uid && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isLoggedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentChoice', 'expiresAt', 'warningSent', 'updatedAt']));
        allow delete: if isAdmin(); 
      }

      match /leaderboard/{rankId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      // Payment-related 6: tournaments/{t}/upcomingRegistrations
      match /upcomingRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && request.resource.data.get('userId', '') == request.auth.uid)) 
                      && request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] 
                      && request.resource.data.get('status', '') != 'approved'
                      && isTournamentOpen(tournamentId));
        allow update: if isAdmin() || (isOwner(docId) && 
          request.resource.data.get('paymentStatus', '') in ['pending', 'pending_verification'] &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'paymentStatus'])
        );
        allow delete: if isOwner(docId) || isAdmin();
      }

      match /lockedRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==========================================
    // 5. TEAMS COLLECTION
    // ==========================================
    match /teams/{teamId} {
      allow read: if isLoggedIn();
      // Allow team creation; safely handles new signups where user document does not exist yet
      allow create: if isLoggedIn() 
                    && ('maxMembers' in request.resource.data && request.resource.data.maxMembers is number && request.resource.data.maxMembers > 0)
                    && request.resource.data.get('leaderId', '') == request.auth.uid
                    && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamId', null) == null)
                    && ('teamName' in request.resource.data && request.resource.data.teamName is string && request.resource.data.teamName.size() >= 2 && request.resource.data.teamName.size() <= 50);
      
      allow delete: if isAdmin() || (isLoggedIn() && resource.data.get('leaderId', '') == request.auth.uid && !resource.data.get('hasActiveRegistration', false));
      
      allow update: if isAdmin() 
        || (isLoggedIn() && resource.data.get('leaderId', '') == request.auth.uid)
        || (isLoggedIn() && ('members' in resource.data && request.auth.uid in resource.data.members))
        || (isLoggedIn() 
            && ('members' in request.resource.data && request.auth.uid in request.resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() <= resource.data.get('maxMembers', 5)
            && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamId', null) == null));
      
      match /wallet/{walletId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin(); 
      }
      
      match /transactions/{txId} {
        allow read: if isAdmin() || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow write: if isAdmin();
      }
      
      match /tournamentHistory/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // 6. SYSTEM & ADMIN DATA
    // ==========================================
    match /refundRequests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminNotifications/{notifId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /reports/{reportId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /calendarEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /systemEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /broadcastNotifications/{notifId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // ==========================================
    // 7. PUSH NOTIFICATION QUEUE
    // ==========================================
    match /pushQueue/{userId}/tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 8. PAYMENT & WALLET SYSTEM
    // ==========================================
    match /submitted_utrs/{utr} {
      // 🔒 Anti-Duplicate: Client can only record a UTR if it has NOT been submitted before
      allow create: if isAdmin() || (isLoggedIn() 
                    && !exists(/databases/$(database)/documents/submitted_utrs/$(utr))
                    && utr.matches('^[0-9]{12}$'));
      allow read, update, delete: if isAdmin();
    }
    
    match /team_verification_history/{teamId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow create: if isLoggedIn() 
                    && request.resource.data.get('userId', '') == request.auth.uid
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('amount', 0) is number
                    && request.resource.data.get('amount', 0) > 0;
      allow read: if isAdmin() || (isLoggedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
  }
}
