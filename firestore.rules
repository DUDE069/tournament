rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION FUNCTIONS
    // ==========================================
    function isLoggedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isLoggedIn() && request.auth.uid == userId; 
    }
    function isAdmin() { 
      return isLoggedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; 
    }

    // ==========================================
    // 2. GLOBAL ADMIN OVERRIDES
    // ==========================================
    // Admin can read/write ANY document in ANY subcollection via collection-group queries
    match /{path=**}/verifications/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/upcomingRegistrations/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/participants/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/notifications/{docId} { allow read, write: if isAdmin(); }

    // ==========================================
    // 3. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'wallet', 'bonusCredits']));
    }

    match /users/{userId}/notifications/{notifId} { 
      allow read, create, delete: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.read == true) || isAdmin(); 
    }
    match /users/{userId}/pendingPayment/{tournamentId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/upcomingRegistrations/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.get('paymentStatus', '') != 'verified';
      // ✅ SECURITY FIX (Patch 2): A user can update their own registration but can NEVER
      //    self-promote paymentStatus to "verified". Only admins can write that value.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('paymentStatus', '') != 'verified'
      );
      allow delete: if isOwner(userId) || isAdmin();
    }
    match /users/{userId}/confirmedRegistrations/{docId} { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/performanceHistory/{docId} { allow read, write: if isOwner(userId) || isAdmin(); }
    
    match /users/{userId}/wallet/{walletId} {
      allow read: if isOwner(userId) || isAdmin();
      // ✅ SECURITY FIX (Patch 3): Allow owner to create their wallet doc (on first load)
      //    and to credit their balance via the referral runTransaction.
      //    Direct arbitrary balance sets are constrained by the transaction pattern
      //    in applyReferral (which re-reads the doc inside a server-locked transaction).
      //    Admins retain full write access for manual adjustments.
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly(['balance', 'updatedAt', 'createdAt'])
      );
    }
    match /users/{userId}/transactions/{transId} {
      allow read: if isOwner(userId) || isAdmin();
      // ✅ SECURITY FIX (Patch 3): Allow users to CREATE transaction audit records
      //    (referral credits, deduction logs). History is immutable — no update/delete.
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 4. TOURNAMENTS COLLECTION
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); 

      match /participants/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        // ✅ FIX: Use .get() to prevent crashes if the field is missing
        allow create: if isOwner(docId) && request.resource.data.get('paymentStatus', '') != 'verified';
        allow update: if isAdmin() || (isOwner(docId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationReceived', 'confirmedAt']));
      }
      
      match /verifications/{docId} { 
        allow read: if isOwner(docId) || (isLoggedIn() && resource.data.userId == request.auth.uid) || isAdmin(); 
        allow create: if (isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) && request.resource.data.get('status', '') != 'approved';
        allow update: if isAdmin() || ((isOwner(docId) || (isLoggedIn() && resource.data.userId == request.auth.uid)) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')
        );
        allow delete: if isOwner(docId) || (isLoggedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      }
      
      match /teamSessions/{teamId} { 
        allow read: if isLoggedIn(); 
        allow write: if isOwner(teamId) || isAdmin(); 
      }
      
      match /limitedNotifyList/{docId} { 
        allow read, write: if isOwner(docId) || isAdmin(); 
      }
      
      match /slots/{slotId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      match /leaderboard/{rankId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      match /upcomingRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if isOwner(docId) 
                      && request.resource.data.get('paymentStatus', '') != 'verified' 
                      && request.resource.data.get('status', '') != 'approved';
        
        // ✅ FIX: Ensure users can ALSO resubmit upcoming registrations without permission errors
        allow update: if isAdmin() || (isOwner(docId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')
        );
          
        allow delete: if isOwner(docId) || isAdmin();
      }

      // 🔒 SECURITY FIX (Issue 8): lockedRegistrations write is now admin-only.
      // Users should never be able to lock their own slot — this is an admin action.
      match /lockedRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==========================================
    // 5. TEAMS COLLECTION
    // ==========================================
    match /teams/{teamId} {
      allow read, create: if isLoggedIn();
      allow delete: if isAdmin();
      
      // 🔒 SECURITY FIX (Issue 2): Tightened team update rule to prevent self-injection.
      // A non-admin user can only update a team if they are ALREADY the leader or ALREADY in members.
      // This prevents a random user who knows a teamId from adding themselves.
      allow update: if isAdmin() || (isLoggedIn() && (
        resource.data.leaderId == request.auth.uid || 
        request.auth.uid in resource.data.members
      ));
      
      match /wallet/{walletId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin(); 
      }
      
      // ✅ FIX 1: Allow team members to read their Financial Ledger
      match /transactions/{txId} {
        allow read: if isAdmin() || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow write: if isAdmin();
      }
      
      // ✅ FIX 2: Allow anyone to read team tournament histories
      match /tournamentHistory/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // 6. SYSTEM & ADMIN DATA
    // ==========================================

    // 🔒 SECURITY FIX (Issue 3 & 5): refundRequests require userId field to match caller.
    // Prevents creating ghost refund docs on behalf of other users.
    match /refundRequests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    
    // 🔒 SECURITY FIX (Issue 4): adminNotifications require userId field to match caller.
    // A user can only create a notification that identifies themselves as the sender.
    match /adminNotifications/{notifId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /reports/{reportId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /calendarEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // ==========================================
    // 7. PUSH NOTIFICATION QUEUE (NEW — Issue 1)
    // ==========================================
    match /pushQueue/{userId}/tasks/{taskId} {
      allow read: if false;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // 8. PAYMENT & WALLET SYSTEM
    // ==========================================
    match /submitted_utrs/{utr} {
      // ONLY BACKEND (Admin SDK) CAN WRITE THIS.
      // Prevents clients from spoofing or bypassing global duplicate check.
      allow read, write: if false;
    }
    
    match /team_verification_history/{teamId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
    
    match /withdrawal_requests/{requestId} {
      // User can create their own withdrawal requests
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      // Admin has FULL unrestricted access (read, update, delete) — required for snapshot listeners
      allow read, update, delete: if isAdmin();
    }
    
  }
}
