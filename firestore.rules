rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION FUNCTIONS
    // ==========================================
    function isLoggedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isLoggedIn() && request.auth.uid == userId; 
    }
    function isAdmin() { 
      // SECURE ADMIN CHECK: Relies on a hidden root-level collection
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }

    // ==========================================
    // 2. ADMINS COLLECTION
    // ==========================================
    match /admins/{uid} {
      allow read, write: if false; // Only backend or Firebase Console can manage this
    }

    // ==========================================
    // 3. USERS COLLECTION (Data Splitting)
    // ==========================================
    match /users/{userId} {
      // PUBLIC DATA: Anyone logged in can read public profiles (nickname, gameRole, teamId)
      allow read: if isLoggedIn();
      allow create: if isOwner(userId);
      // Only allow updating specific public fields
      allow update: if isAdmin() || (isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'gameRole', 'freeFireUid', 'teamId', 'teamName', 'teamCode', 'stats', 'role', 'isLeader', 'uid', 'createdAt']));
      
      // PRIVATE DATA: Highly restricted subcollection for email, age, phone, etc.
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // WALLET & TRANSACTIONS: Strict constraints for runTransaction
      match /wallet/{walletId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        
        // VULNERABILITY PATCHED:
        // Users can ONLY update the balance field, AND the new balance must be less than or equal to the old balance (deductions only).
        // It must also never drop below 0. 
        // Only Admins can manually increase a user's balance.
        allow update: if isAdmin() || (
          isOwner(userId) && 
          request.resource.data.keys().hasOnly(['balance', 'updatedAt']) &&
          request.resource.data.balance <= resource.data.balance &&
          request.resource.data.balance >= 0
        );
      }
      
      match /transactions/{transId} { 
        allow read: if isOwner(userId) || isAdmin(); 
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin(); // Users cannot modify/delete history
      }
      
      // OTHER USER SUBCOLLECTIONS
      match /notifications/{notifId}        { allow read, write: if isOwner(userId) || isAdmin(); }
      match /upcomingRegistrations/{docId}  { allow read, write: if isOwner(userId) || isAdmin(); }
      match /confirmedRegistrations/{docId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /performanceHistory/{docId}     { allow read, write: if isOwner(userId) || isAdmin(); }
      match /pendingPayment/{tournamentId}  { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // ==========================================
    // 4. TOURNAMENTS COLLECTION
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); 

      match /{path=**}/participants/{docId}           { allow read, write: if isAdmin(); }
      match /{path=**}/verifications/{docId}          { allow read, write: if isAdmin(); }
      match /teamSessions/{teamId}                    { allow read: if isLoggedIn(); allow write: if isOwner(teamId) || isAdmin(); }
      match /slots/{slotId}                           { allow read: if true; allow write: if isAdmin(); }
      match /leaderboard/{rankId}                     { allow read: if true; allow write: if isAdmin(); }
      match /upcomingRegistrations/{docId}            { allow read, write: if isOwner(docId) || isAdmin(); }
      match /lockedRegistrations/{docId}              { allow read: if isOwner(docId) || isAdmin(); allow write: if isAdmin(); }
      match /limitedNotifyList/{docId}                { allow read, write: if isOwner(docId) || isAdmin(); }
    }

    // ==========================================
    // 5. TEAMS COLLECTION
    // ==========================================
    match /teams/{teamId} {
      allow read, create: if isLoggedIn();
      allow delete: if isAdmin();
      allow update: if isAdmin() 
        || (isLoggedIn() && resource.data.leaderId == request.auth.uid)
        || (isLoggedIn() && request.auth.uid in resource.data.members)
        || (isLoggedIn() && request.auth.uid in request.resource.data.members && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      
      match /wallet/{walletId} { allow read: if isLoggedIn(); allow write: if isAdmin(); }
      match /transactions/{txId} { allow read: if isAdmin() || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members); allow create: if isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members; allow update, delete: if isAdmin(); }
      match /tournamentHistory/{docId} { allow read: if true; allow write: if isAdmin(); }
    }
    
    // ==========================================
    // 6. SYSTEM & ADMIN DATA
    // ==========================================
    match /withdrawal_requests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /adminNotifications/{notifId} { allow create: if isLoggedIn(); allow read, update, delete: if isAdmin(); }
    match /refundRequests/{requestId} { allow create: if isLoggedIn(); allow read, update, delete: if isAdmin(); }
    match /reports/{reportId} { allow create: if isLoggedIn(); allow read, update, delete: if isAdmin(); }
    match /calendarEvents/{eventId} { allow read: if true; allow write: if isAdmin(); }
    match /pushQueue/{userId}/tasks/{taskId} { allow read: if false; allow write: if isAdmin(); }
    match /submitted_utrs/{utr} { allow read, write: if false; }
    match /team_verification_history/{teamId} { allow read: if isLoggedIn(); allow write: if isAdmin(); }
  }
}
