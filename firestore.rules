rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION FUNCTIONS
    // ==========================================
    function isLoggedIn() { 
      return request.auth != null; 
    }
    function isOwner(userId) { 
      return isLoggedIn() && request.auth.uid == userId; 
    }
    function isAdmin() { 
      return isLoggedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; 
    }

    // ==========================================
    // 2. GLOBAL ADMIN OVERRIDES
    // ==========================================
    match /{path=**}/verifications/{docId}         { allow read, write: if isAdmin(); }
    match /{path=**}/upcomingRegistrations/{docId} { allow read, write: if isAdmin(); }
    match /{path=**}/participants/{docId}           { allow read, write: if isAdmin(); }
    match /{path=**}/transactions/{docId}           { allow read, write: if isAdmin(); }
    match /{path=**}/notifications/{docId}          { allow read, write: if isAdmin(); }

    // ==========================================
    // 3. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'wallet', 'bonusCredits']));
    }

    match /users/{userId}/notifications/{notifId}           { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/pendingPayment/{tournamentId}     { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/upcomingRegistrations/{docId}     { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/confirmedRegistrations/{docId}    { allow read, write: if isOwner(userId) || isAdmin(); }
    match /users/{userId}/performanceHistory/{docId}        { allow read, write: if isOwner(userId) || isAdmin(); }
    
    match /users/{userId}/wallet/{walletId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users can create their own wallet doc (first load / referral credits)
      allow create: if isOwner(userId) || isAdmin();
      // Users can only update balance fields; admins have full access
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly(['balance', 'updatedAt', 'createdAt'])
      );
    }
    match /users/{userId}/transactions/{transId} { 
      allow read: if isOwner(userId) || isAdmin(); 
      // Users can create transaction audit records (referral credits, deductions)
      allow create: if isOwner(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 4. TOURNAMENTS COLLECTION
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(); 

      match /participants/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if (isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.get('paymentStatus', '') != 'verified';
        allow update: if isAdmin() || (isOwner(docId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationReceived', 'confirmedAt']));
      }
      
      match /verifications/{docId} { 
        allow read: if isOwner(docId) || isAdmin(); 
        allow create: if (isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.get('status', '') != 'approved';
        allow update: if isAdmin() || (isOwner(docId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')
        );
        allow delete: if isOwner(docId) || isAdmin();
      }
      
      match /teamSessions/{teamId} { 
        allow read: if isLoggedIn(); 
        allow write: if isOwner(teamId) || isAdmin(); 
      }
      
      match /limitedNotifyList/{docId} { 
        allow read, write: if isOwner(docId) || isAdmin(); 
      }
      
      match /slots/{slotId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      match /leaderboard/{rankId} {
        allow read: if true; 
        allow write: if isAdmin(); 
      }

      match /upcomingRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow create: if (isOwner(docId) || (isLoggedIn() && request.resource.data.userId == request.auth.uid)) 
                      && request.resource.data.get('paymentStatus', '') != 'verified' 
                      && request.resource.data.get('status', '') != 'approved';
        allow update: if isAdmin() || (isOwner(docId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'pending')
        );
        allow delete: if isOwner(docId) || isAdmin();
      }

      match /lockedRegistrations/{docId} {
        allow read: if isOwner(docId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ==========================================
    // 5. TEAMS COLLECTION
    // ==========================================
    match /teams/{teamId} {
      allow read, create: if isLoggedIn();
      allow delete: if isAdmin();
      
      allow update: if isAdmin() 
        || (isLoggedIn() && resource.data.leaderId == request.auth.uid)
        || (isLoggedIn() && request.auth.uid in resource.data.members)
        || (isLoggedIn() 
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
      
      match /wallet/{walletId} { 
        allow read: if isLoggedIn(); 
        allow write: if isAdmin(); 
      }
      
      match /transactions/{txId} {
        allow read: if isAdmin() || (isLoggedIn() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow write: if isAdmin();
      }
      
      match /tournamentHistory/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // ==========================================
    // 6. SYSTEM & ADMIN DATA
    // ==========================================
    match /refundRequests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminNotifications/{notifId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /reports/{reportId} { 
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin(); 
    }
    
    match /calendarEvents/{eventId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // ==========================================
    // 7. PUSH NOTIFICATION QUEUE
    // ==========================================
    match /pushQueue/{userId}/tasks/{taskId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // ==========================================
    // 8. PAYMENT & WALLET SYSTEM
    // ==========================================
    match /submitted_utrs/{utr} {
      // Backend Admin SDK only — prevents clients from spoofing UTR duplicates
      allow read, write: if false;
    }
    
    match /team_verification_history/{teamId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ⚠️ CRITICAL: This is the correct collection name used by admin.js
    match /withdrawal_requests/{requestId} {
      allow create: if isLoggedIn() && request.resource.data.userId == request.auth.uid;
      // Full admin access required for real-time snapshot listeners
      allow read, update, delete: if isAdmin();
    }
    
  }
}
